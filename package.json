{
  "name": "asset-wish",
  "private": true,
  "type": "module",
  "scripts": {
    "pretypecheck": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint worker",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dev": "wrangler dev",
    "types": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply asset-wish --local",
    "migrate:remote": "wrangler d1 migrations apply asset-wish --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
